target sb_host_tool

    type        exe
    root        source/sandbox/host/sb_host_tool
    folder      09_SANDBOX/HOST
    unit        sb_host_tool.c
    dep         mod sys ref prof pack fs job net app core run
    mono_dep    render rhi draw

target sb_host_server

    type        exe
    root        source/sandbox/host/sb_host_server
    folder      09_SANDBOX/HOST
    unit        sb_host_server.c
    dep         mod sys ref prof pack fs job net app core run
    mono_dep    render rhi draw example

target sb_host_editor

    type        exe
    root        source/sandbox/host/sb_host_editor
    folder      09_SANDBOX/HOST
    unit        sb_host_editor.c
    dep         mod sys ref prof pack fs job net app core run
