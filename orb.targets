target sb_gui_timeline					# prof timeline overlay (flame graph) + synthetic workload

    type        exe
    root        source/sandbox/gui/sb_gui_timeline
    folder      09_SANDBOX/GUI
    unit        sb_gui_timeline.c
    unit        gui_timeline.c
