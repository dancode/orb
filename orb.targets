target sb_gui_style						# style + look bench: editor, gallery, C exporter, font tool

    type        exe
    root        source/sandbox/gui/sb_gui_style
    folder      09_SANDBOX/GUI
    unit        sb_gui_style.c
    dep         mod sys ref prof pack fs job net app core run
