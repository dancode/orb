  # flag        reflect

target sb_vulkan_stress					# multi-context rhi sync stress test

    type        exe
    root        source/sandbox/rhi/sb_vulkan_stress
    folder      09_SANDBOX/RHI
    unit        sb_vulkan_stress.c
    dep         mod sys ref job app core
    dep         rhi

