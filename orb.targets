target sb_host_runtime_proj			# BYPASS PROOF: drives run_project.h directly -- no game framework in k_modules

    type        exe
    root        source/sandbox/host/sb_host_runtime_proj
    folder      09_SANDBOX/HOST
    unit        sb_host_runtime_proj.c
    dep         mod sys ref prof pack fs job net app core run
    dep         rhi draw
