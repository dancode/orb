target sb_gui_stress					# gui load-limit bench: 5 routines on number keys, 0 = idle

    type        exe
    root        source/sandbox/gui/sb_gui_stress
    folder      09_SANDBOX/GUI
    unit        sb_gui_stress.c
    dep         mod sys ref job app core
    dep         rhi gui base

# ==============================================================================
# 09_SANDBOX -- HOST (host functionality tests, one per host shape)
