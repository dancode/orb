target sb_proj_runtime					# framework-BYPASS project DLL -- core+render only; sb_host_runtime_proj drives it

    type        dynamic
    root        source/sandbox/host/sb_proj_runtime
    folder      09_SANDBOX/HOST
    unit        sb_proj_runtime.c
    run         sb_host_runtime_proj


# ==============================================================================
# 10_TOOLS -- Standalone offline CLI tools (no engine runtime dependency)
# ==============================================================================

target font_tool

    type        exe
    root        source/tools/font_tool
    folder      08_TOOL
    unit        font_tool.c
    flag        is_tool
    dep         sys dev_font
    inc         third_party/freetype-2.14.3/include
    link_flag   all  third_party/freetype-2.14.3/objs/x64/Release/freetype.lib

target asset_tool

    type        exe
    root        source/tools/asset_tool
    folder      08_TOOL
    unit        asset_tool.c
    flag        is_tool
    dep         sys pack

target shader_tool

    type        exe
    root        source/tools/shader_tool
    folder      08_TOOL
    unit        shader_tool.c
    unit        shader_tool_spirv_reflect.c   # vendored SPIRV-Reflect; own TU, not shader_tool unity
    flag        is_tool
    dep         sys

target image_tool

    type        exe
    root        source/tools/image_tool
    folder      08_TOOL
    unit        image_tool.c
    flag        is_tool
    dep         sys dev_image

target ship_tool

    type        exe
    root        source/tools/ship_tool
    folder      08_TOOL
    unit        ship_tool.c
    flag        is_tool
    dep         sys pack dev_ship

target launch_tool						# project manager / command hub -- the one gui()-driven tool

    type        exe
    root        source/tools/launch_tool
    folder      08_TOOL
    unit        launch_tool.c
    flag        is_tool
    dep         mod sys ref job app core
    dep         rhi gui base

# ==============================================================================
# DEV : Development Solution Wihout Any Sandbox or Test Code
# ==============================================================================

solution orb_runtime

    out         build/proj
# 	nav 		source
    startup     sb_host_runtime

	# 			--- STANDARD LIBRARY ---
    add         base

	# 			--- ENGINE ---
    add         sys ref prof mod app core job net

	# 			--- RUNTIME ---
    add         run

	# 			--- RUNTIME SERVICES ---
    add         rhi
    add         draw
    add         gui
    add         ahi

	# 			--- RUNTIME MODULES ---
