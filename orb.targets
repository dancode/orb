# ==============================================================================
# Project Modules And Targets
# ==============================================================================
#
# source/
# +-- base/               # Stateless stdlib (math, strings, memory) -- no global state
# +-- engine/             # Engine root libraries: mod, sys, ref, prof, pack, fs, job, net, core, app
# +-- runtime/            # Host runtime scaffolding (run_host)
# +-- runtime_service/    # Static services: rhi, draw, gui, input, asset, ahi
# +-- runtime_modules/    # Dynamic DLL modules: render, audio, physics
# +-- developer/          # Dev-only libs: dev_build, dev_font, dev_hot, dev_image
# +-- game/               # Reusable game framework (runner; world, entity, component to come)
# +-- game_service/       # Game-specific static services
# +-- game_modules/       # Game-specific dynamic modules
# +-- project/            # User game project implementations (e.g. sample_game)
# +-- editor/             # Editor framework (windows, panels, tools)
# +-- editor_service/     # Editor-specific static services
# +-- editor_modules/     # Editor-specific dynamic modules
# +-- tools/              # Standalone utilities (build_tool, asset pipeline)
# +-- sandbox/            # Layer-specific verification targets (sb_*)
# +-- host/               # Executable entry points
# +-- vendor/             # Third-party dependencies
# +-- orb.h               # Top-level umbrella header
#
# ==============================================================================
#
# orb.targets -- project target and solution registry.
# Format reference: source/tools/build_tool/build_tool_03_registry.c
#
# ==============================================================================
# 01_BASE
# ==============================================================================

target base

    type        static
    root        source/base
    folder      01_BASE
    unit        base.c

# ==============================================================================
# 02_ENGINE
# ==============================================================================

target sys

    type        static
    root        source/engine/sys
    folder      02_ENGINE
    unit        sys.c
    flag        host_only

target ref

    type        static
    root        source/engine/ref
    folder      02_ENGINE
    unit        ref.c
    flag        host_only

target prof

    type        static
    root        source/engine/prof
    folder      02_ENGINE
    unit        prof.c
    dep         sys
    flag        host_only

target mod

    type        static
    root        source/engine/mod
    folder      02_ENGINE
    unit        mod.c
    dep         sys
    flag        host_only

target app

    type        static
    root        source/engine/app
    folder      02_ENGINE
    unit        app.c
#   dep         sys			#currently doesnt actually need it
    flag        host_only

target core

    type        static
    root        source/engine/core
    folder      02_ENGINE
    unit        core.c
    dep         sys ref
    flag        reflect host_only

target job

    type        static
    root        source/engine/job
    folder      02_ENGINE
    unit        job.c
    dep         sys
    flag        host_only

target net

    type        static
    root        source/engine/net
    folder      02_ENGINE
    unit        net.c
    dep         sys
    flag        host_only

target pack

    type        static
    root        source/engine/pack
    folder      02_ENGINE
    unit        pack.c
    unit        pack_miniz.c   # vendored miniz amalgamation (engine-wide single copy); own TU, not pack unity
    flag        host_only

target fs

    type        static
    root        source/engine/fs
    folder      02_ENGINE
    unit        fs.c
    dep         sys pack
    flag        host_only

# ==============================================================================
# 03_RUNTIME
# ==============================================================================

target run

    type        static
    root        source/runtime
    folder      03_RUNTIME
    unit        run.c
    dep         mod sys ref prof job net app core   # engine floor: run.c loads all of these in run_host_main

# ==============================================================================
# 03_RUNTIME_SERVICE
# ==============================================================================

target rhi

    type        static
    root        source/runtime_service/rhi
    folder      03_RUNTIME/SERVICE
    unit        rhi.c
    dep         sys app core
    inc         %VULKAN_SDK%/Include

target draw

    type        static
    root        source/runtime_service/draw
    folder      03_RUNTIME/SERVICE
    unit        draw.c
    dep         rhi

target gui

    type        static
    root        source/runtime_service/gui
    folder      03_RUNTIME/SERVICE
    unit        gui_log.c   				# GUI_LOG unit: leaf diagnostics floor (gui_log + host sink)
    unit        gui_rect.c  				# GUI_RECT unit: leaf geometry + color primitives
    unit        gui_font.c   				# GUI_FONT unit: leaf font-metrics library (measurement, not drawing)
    unit        gui.c   					# gui module face: vtable + descriptor + DLL exports
    unit        gui_frame.c  				# GUI_FRAME unit: the frame orchestrator (top of the stack)
    unit        gui_core.c  				# GUI_CORE unit: the interact server (io, ids, state, item protocol)
    unit        gui_style.c  				# GUI_STYLE unit: theme, stacks, state->color resolution
    unit        gui_interact.c  			# GUI_INTERACT unit: gesture mechanisms (move/resize/drag/feat)
    unit        gui_render.c  				# GUI_RENDER unit: the render server (batch, atlas, pipeline)
    unit        gui_draw.c  				# GUI_DRAW unit: drawing routines + font/icon resources over the server
    unit        gui_component.c 			# GUI_COMPONENT unit: widget logic building blocks (comp_* cores)
    unit        gui_stock.c   				# GUI_STOCK unit: reference widget set (stock_* renders, adornments)
    unit        gui_debug.c   				# GUI_DEBUG unit: dashboard + command stepper (severable)
    unit        gui_flow.c  				# GUI_FLOW unit: layout composition (metrics in, rects out)
    unit        gui_chrome.c   				# GUI_CHROME unit: widgets/table/window/dock/popup/nav

    shader      shaders/gui.vs.hlsl			# cooked to bin/shaders/gui.vs.oshd; the only gui shader source
    shader      shaders/gui.ps.hlsl			# cooked to bin/shaders/gui.ps.oshd

    dep         app rhi base
    tool_dep    asset_tool shader_tool		# the shader cookers, ordered ahead of this target

target asset

    type        static
    root        source/runtime_service/asset
    folder      03_RUNTIME/SERVICE
    unit        asset.c
    dep         fs core rhi

target input

    type        static
    root        source/runtime_service/input
    folder      03_RUNTIME/SERVICE
    unit        input.c
    dep         app core

target console								# developer console UI: gui front end over core's cvar/console backend

    type        static
    root        source/runtime_service/console
    folder      03_RUNTIME/SERVICE
    unit        console.c
    dep         app core gui

target ahi									# audio hardware interface: WASAPI device + mixer

    type        static
    root        source/runtime_service/ahi
    folder      03_RUNTIME/SERVICE
    unit        ahi.c
    dep         core

# ==============================================================================
# 03_RUNTIME_MODULES
# ==============================================================================

target example

    type        dynamic
    root        source/runtime_modules/example
    folder      03_RUNTIME/MODULES
    unit        example.c

target render

    type        dynamic
    root        source/runtime_modules/render
    folder      03_RUNTIME/MODULES
    unit        render.c

target audio

    type        dynamic
    root        source/runtime_modules/audio
    folder      03_RUNTIME/MODULES
    unit        audio.c

target physics

    type        dynamic
    root        source/runtime_modules/physics
    folder      03_RUNTIME/MODULES
    unit        physics.c

# ==============================================================================
# 04_GAME
# ==============================================================================

target game							# game framework runner -- hot-reload DLL, RUN_MODULE( game ) in hosts

    type        dynamic
    root        source/game
    folder      04_GAME
    unit        game.c

# ==============================================================================

target nav

    type        static
    root        source/game_service/nav
    folder      04_GAME/SERVICE
    unit        nav.c

target game_example

    type        dynamic
    root        source/game_modules/game_example
    folder      04_GAME/MODULES
    unit        game_example.c

# ==============================================================================
# 05_EDITOR
# ==============================================================================

target editor

    type        static
    root        source/editor
    folder      05_EDITOR
    unit        editor.c
    dep         core gui run base
	dep 		editor_viewport

# ==============================================================================

target 	editor_viewport

    type        static
    root        source/editor_service/viewport
    folder      05_EDITOR/SERVICE
    unit        viewport.c
    dep         core gui base

target 	editor_example

    type        dynamic
    root        source/editor_modules/editor_example
    folder      05_EDITOR/MODULES
    unit        editor_example.c

# ==============================================================================
# 06_Project
# ==============================================================================

target sample_game					# canonical project DLL -- host_game -module sample_game; -create template source

    type        dynamic
    root        source/project/sample_game
    folder      06_PROJECT
    unit        sample_game.c
    unit        game_ui.c   # the game kit (S3): HUD over gui's element tier
    run         host_editor -module sample_game
	dep 		editor

target sample_game_play				# F5 launcher: builds sample_game.dll, plays it under host_game

    alias       sample_game
    folder      06_PROJECT
    run         host_game -module sample_game

target sample_game_ship				# single-exe ship shape: build with -monolithic; project compiled in

    type        exe
    root        source/host/game
    folder      06_PROJECT
    unit        host_game_main.c
    define      HOST_PROJECT=sample_game
    dep         base mod sys ref prof pack fs job net app core run
    dep         host_common rhi draw console gui dev_font
    mono_dep    render game sample_game


target template_game				# source template for -create <name> -type project

    type        exe
    root        source/project/template_game
    folder      06_PROJECT
    unit        main.c
    dep         mod sys ref prof pack fs job net app core run
    dep         rhi draw
    mono_dep    render

# ==============================================================================
# 07_Developer
# ==============================================================================

target dev_build

    type        static
    root        source/developer/dev_build
    folder      07_DEVELOPER
    unit        dev_build.c
    dep         sys

target dev_hot

    type        static
    root        source/developer/dev_hot
    folder      07_DEVELOPER
    unit        dev_hot.c
    dep         sys
    dep         dev_build

target dev_font

    type        static
    root        source/developer/dev_font
    folder      07_DEVELOPER
    unit        dev_font.c
    dep         sys

target dev_image

    type        static
    root        source/developer/dev_image
    folder      07_DEVELOPER
    unit        dev_image.c
    dep         sys

target dev_ship

    type        static
    root        source/developer/dev_ship
    folder      07_DEVELOPER
    unit        dev_ship.c
    dep         sys pack

# ==============================================================================
# 08_Host : Shared Host Executable Libraries
# ==============================================================================

target host_common

    type        static
    root        source/host/common
    folder      08_HOST
    unit        host_common.c

target host_game

    type        exe
    root        source/host/game
    folder      08_HOST
    unit        host_game_main.c
    dep         mod sys ref prof pack fs job net app core run
    dep         host_common rhi draw gui console dev_font base
    mono_dep    render game

target host_editor

    type        exe
    root        source/host/editor
    folder      08_HOST
    unit        host_editor_main.c
    dep         mod sys ref prof pack fs job net app core run
    dep         host_common rhi draw gui console editor editor_viewport dev_font base
    mono_dep    render game

# ==============================================================================
# 09_SANDBOX -- BASE
# ==============================================================================

target sb_base

    type        exe
    root        source/sandbox/base
    folder      09_SANDBOX/BASE
    unit        sb_base.c
    dep         base

# ==============================================================================
# 09_SANDBOX -- ENGINE
# ==============================================================================

target sb_mod

    type        exe
    root        source/sandbox/engine/sb_mod
    folder      09_SANDBOX/ENGINE
    unit        sb_mod.c
    dep         mod sys ref
    dep         dev_build dev_hot
    mono_dep    example

target sb_sys

    type        exe
    root        source/sandbox/engine/sb_sys
    folder      09_SANDBOX/ENGINE
    unit        sb_sys.c
    dep         sys

target sb_app

    type        exe
    root        source/sandbox/engine/sb_app
    folder      09_SANDBOX/ENGINE
    unit        sb_app.c
    dep         mod sys app

target sb_core

    type        exe
    root        source/sandbox/engine/sb_core
    folder      09_SANDBOX/ENGINE
    unit        sb_core.c
    dep         sys core

target sb_job

    type        exe
    root        source/sandbox/engine/sb_job
    folder      09_SANDBOX/ENGINE
    unit        sb_job.c
    dep         sys job

target sb_net

    type        exe
    root        source/sandbox/engine/sb_net
    folder      09_SANDBOX/ENGINE
    unit        sb_net.c
    dep         sys net

target sb_prof

    type        exe
    root        source/sandbox/engine/sb_prof
    folder      09_SANDBOX/ENGINE
    unit        sb_prof.c
    dep         sys prof

target sb_fs

    type        exe
    root        source/sandbox/engine/sb_fs
    folder      09_SANDBOX/ENGINE
    unit        sb_fs.c
    dep         mod sys pack fs

# ==============================================================================
# 09_SANDBOX -- RUNTIME (runtime service tests)
# ==============================================================================

target sb_asset_test						# asset service registry + hot reload

    type        exe
    root        source/sandbox/runtime/sb_asset_test
    folder      09_SANDBOX/RUNTIME
    unit        sb_asset_test.c
    dep         mod sys ref pack fs app core asset rhi

target sb_asset_image						# asset service Phase 3: PNG -> bindless texture -> on-screen quad

    type        exe
    root        source/sandbox/runtime/sb_asset_image
    folder      09_SANDBOX/RUNTIME
    unit        sb_asset_image.c
    dep         mod sys ref pack fs app core
    dep         rhi draw asset

target sb_asset_shader						# shader system Phase 5: asset_tool .hlsl cook -> .oshd asset -> hash-gated hot reload

    type        exe
    root        source/sandbox/runtime/sb_asset_shader
    folder      09_SANDBOX/RUNTIME
    unit        sb_asset_shader.c
    dep         mod sys ref pack fs app core
    dep         rhi asset

target sb_input								# input action service: binds -> +/- cmds -> action state

    type        exe
    root        source/sandbox/runtime/sb_input
    folder      09_SANDBOX/RUNTIME
    unit        sb_input.c
    dep         mod sys ref app core input

target sb_audio								# audio stack: ahi service + audio module

    type        exe
    root        source/sandbox/runtime/sb_audio
    folder      09_SANDBOX/RUNTIME
    unit        sb_audio.c
    dep         mod sys ref core ahi
    mono_dep    audio

# ==============================================================================
# 09_SANDBOX -- GAME
# ==============================================================================

target sb_world								# world framework: ent/comp pools, queries, rebind
    type        exe
    root        source/sandbox/game/sb_world
    folder      09_SANDBOX/GAME
    unit        sb_world.c
    dep         mod sys ref core

# ==============================================================================
# 09_SANDBOX -- REFLECT
# ==============================================================================

target sb_reflect							# dll test code

    type        exe
    root        source/sandbox/reflect/sb_reflect_unit
    folder      09_SANDBOX/REFLECT
    unit        sb_reflect_unit.c
    dep         ref

target sb_ref_dll						# a dll that has reflected types

    type        dynamic
    root        source/sandbox/reflect/sb_ref_dll
    folder      09_SANDBOX/REFLECT
    unit        sb_ref_dll.c
    flag        reflect

target sb_gen_dll							# REF_MODULE() usage

    type        dynamic
    root        source/sandbox/reflect/sb_gen_dll
    folder      09_SANDBOX/REFLECT
    unit        sb_gen_dll.c
    flag        reflect

target sb_ref_exe					# load a dll with reflected types

    type        exe
    root        source/sandbox/reflect/sb_ref_exe
    folder      09_SANDBOX/REFLECT
    unit        sb_ref_exe.c
    dep         mod sys ref core
    mono_dep    sb_ref_dll

target sb_gen_exe						# load a REF_MODULE() dll

    type        exe
    root        source/sandbox/reflect/sb_gen_exe
    folder      09_SANDBOX/REFLECT
    unit        sb_gen_exe.c
    dep         mod sys ref core
    mono_dep    sb_gen_dll
    flag        reflect

