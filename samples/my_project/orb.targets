# orb.targets -- my_project
#
# 'engine' declares the ORB installation this project builds on:
#   - All engine targets are available as deps and build on demand into this
#     project's bin/ (they are excluded from local build-all/gen/clean).
#   - Engine headers (engine/sys/sys.h etc.) are on the include path automatically.
#   - Built-in tools (build_tool, reflect_tool) resolve from the engine root.
#
# This project builds my_project.dll -- a game module (runtime/run_project.h contract)
# run by the engine's hosts.  -monolithic is not supported for project DLLs.
#
# Workflow:
#   bin\build_tool.bat -gen      generate VS project files (build/proj)
#   bin\build_tool.bat           build (add -config Release as needed)
#   "F:\orb\bin\host_game.exe"   -project .     play it
#   "F:\orb\bin\host_editor.exe" -project .     edit it (Play/Stop)
#
# In Visual Studio, F5 does the same via the 'run' lines below: the startup
# project launches host_editor; set 'my_project_play' as startup to launch host_game.

engine  ../../

target my_project

    type        dynamic
    root        src
    folder      01_MY_PROJECT
    unit        my_project.c
    run         host_editor -project .

# F5 launcher: builds my_project.dll, runs it standalone under host_game.
target my_project_play

    alias       my_project
    folder      01_MY_PROJECT
    run         host_game -project .

solution my_project

    out         build/proj
    startup     my_project
    add         my_project my_project_play

    # Engine targets included for source navigation and debugging.
    add         base sys ref mod app core job
    add         run rhi draw render game
