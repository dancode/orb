*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# Build directories
/[Bb]uild/
/[Bb]uild_*/
/[Bb]in/
/[Oo]ut/
cmake-build-*/

# Standalone project outputs (any subdirectory project)
*/[Bb]uild/
*/[Bb]in/
*/.vscode/

# VS Code workspace settings
/.vscode/

# clangd / LSP generated files
/compile_commands.json
*/compile_commands.json
/.clangd
*/.clangd

*.code-workspace

# Visual Studio specific
.vs/
*.suo
*.user
*.vcxproj*
*.sln

# Child project engine root marker (machine-local)
.orb_engine

# Scratch space for tests / tools (sandboxes create + clean temp/, debris never commits)
/temp/

# Generated runtime artifacts (profiler traces, hitch captures, future dumps)
/artifacts/

# source_content -- raw tool inputs (TTF, SVG). Committed, so content/ plus this is a complete
# input set and a fresh clone can cook. The font baker's scratch cache is derived, not source.
/source_content/font_cache/

# Third party -- vendored FreeType source and headers are committed so a clone can build,
# and so a POSIX target can build the library from source. MSBuild output (objs/) and the
# generated documentation site (docs/) are not. The prebuilt x64 import lib and DLL are
# re-included by name: build_deploy_third_party mirrors third_party/bin into bin/, and the
# *.lib / *.dll rules above would otherwise drop them.
/third_party/freetype-2.14.3/objs/
/third_party/freetype-2.14.3/docs/
!/third_party/bin/
!/third_party/bin/freetype.lib
!/third_party/bin/freetype.dll

